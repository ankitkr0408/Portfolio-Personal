# Public site URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin portal (/admin) ---
# MongoDB Atlas connection string. Without it the site serves the defaults in lib/data.ts
# and the admin is read-only.
MONGODB_URI=
MONGODB_DB=portfolio

# The one password for /admin. Use a long random passphrase.
ADMIN_PASSWORD=
# Secret used to sign the login cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
